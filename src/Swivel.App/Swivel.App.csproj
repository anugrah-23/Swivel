<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Swivel</AssemblyName>
    <RootNamespace>Swivel.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Swivel's UI is English-only for v1; skip the framework's translated resource folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\swivel.ico</ApplicationIcon>
    <StartupObject>Swivel.App.Program</StartupObject>
    <Version>0.7.0</Version>
    <!-- GitHub repository whose Releases are Swivel's update feed (Velopack). -->
    <SwivelUpdateRepo>https://github.com/anugrah-23/Swivel</SwivelUpdateRepo>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <AssemblyMetadata Include="UpdateRepo" Value="$(SwivelUpdateRepo)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Swivel.Core\Swivel.Core.csproj" />
    <ProjectReference Include="..\Swivel.Native\Swivel.Native.csproj" />
    <ProjectReference Include="..\Swivel.Engines\Swivel.Engines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core engines ship beside Swivel.exe; Pandoc and LibreOffice are optional packs fetched on first use. -->
    <None Include="..\..\engines\ffmpeg\**" Link="engines\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\engines\7zip\**" Link="engines\7zip\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\*-OFL.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

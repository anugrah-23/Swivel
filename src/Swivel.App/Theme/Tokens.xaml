<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens from the Swivel Design Doc. -->
    <Color x:Key="InkColor">#111111</Color>
    <Color x:Key="CreamColor">#FFF6E5</Color>
    <Color x:Key="PaperColor">#FFFFFF</Color>
    <Color x:Key="SunflowerColor">#FFD23F</Color>
    <Color x:Key="PinkColor">#FF7AAC</Color>
    <Color x:Key="SkyColor">#5FB8FF</Color>
    <Color x:Key="MintColor">#3DDC97</Color>
    <Color x:Key="OrangeColor">#FF8A3D</Color>
    <Color x:Key="LilacColor">#C9B8FF</Color>

    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Cream" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="Sunflower" Color="{StaticResource SunflowerColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Sky" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="Mint" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="Lilac" Color="{StaticResource LilacColor}" />

    <!-- Embedded under the SIL Open Font License; see licenses\ next to Swivel.exe. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Archivo, Archivo Black, Segoe UI Black</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Space Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#Space Mono, Consolas</FontFamily>

    <!-- Chunky button: paper fill, 2.5 px ink outline, 3 px hard shadow that collapses on press. -->
    <Style x:Key="SwivelButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="10" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Sunflower}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Margin" Value="1,1,-1,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Chip: a toggle in the button's shape; on = ink with sunflower text, like an active wedge. -->
    <Style x:Key="SwivelChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Shadow" Background="{StaticResource Ink}" CornerRadius="10" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{StaticResource Paper}" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Ink}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Sunflower}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Ink}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource Sunflower}" />
                            <Setter TargetName="Shadow" Property="Background" Value="{StaticResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Field: mono text on paper inside a 2.5 px ink outline. -->
    <Style x:Key="SwivelField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Cream}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: a thick ink track and a chunky sunflower thumb with a hard shadow. -->
    <Style x:Key="SwivelSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Border Background="{StaticResource Ink}" CornerRadius="6" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{StaticResource Sunflower}" BorderBrush="{StaticResource Ink}" BorderThickness="2.5" CornerRadius="6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwivelSlider" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Cream}" BorderBrush="{StaticResource Ink}" BorderThickness="2" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SwivelSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwivelPrimaryButton" TargetType="Button" BasedOn="{StaticResource SwivelButton}">
        <Setter Property="Background" Value="{StaticResource Sunflower}" />
    </Style>
</ResourceDictionary>

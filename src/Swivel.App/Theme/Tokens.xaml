<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens from the Swivel Design Doc. -->
    <Color x:Key="InkColor">#111111</Color>
    <Color x:Key="CreamColor">#FFF6E5</Color>
    <Color x:Key="PaperColor">#FFFFFF</Color>
    <Color x:Key="SunflowerColor">#FFD23F</Color>
    <Color x:Key="PinkColor">#FF7AAC</Color>
    <Color x:Key="SkyColor">#5FB8FF</Color>
    <Color x:Key="MintColor">#3DDC97</Color>
    <Color x:Key="OrangeColor">#FF8A3D</Color>
    <Color x:Key="LilacColor">#C9B8FF</Color>


    <!-- Brushes (Ink, Cream, Paper, Sunflower…) are created in code from these colours at startup:
         Palette.InstallBrushes, which swaps in system colours for high-contrast mode. -->

    <!-- Embedded under the SIL Open Font License; see licenses\ next to Swivel.exe. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Archivo, Archivo Black, Segoe UI Black</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Space Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#Space Mono, Consolas</FontFamily>

    <!-- Chunky button: paper fill, 2.5 px ink outline, 3 px hard shadow that collapses on press. -->
    <Style x:Key="SwivelButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Paper}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Background="{DynamicResource Ink}" CornerRadius="10" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ink}"
                                BorderThickness="2.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Sunflower}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Margin" Value="1,1,-1,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Chip: a toggle in the button's shape; on = ink with sunflower text, like an active wedge. -->
    <Style x:Key="SwivelChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Shadow" Background="{DynamicResource Ink}" CornerRadius="10" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Ink}"
                                BorderThickness="2.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Ink}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Sunflower}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Ink}" />
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource Sunflower}" />
                            <Setter TargetName="Shadow" Property="Background" Value="{DynamicResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Field: mono text on paper inside a 2.5 px ink outline. -->
    <Style x:Key="SwivelField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Paper}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Cream}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: a thick ink track and a chunky sunflower thumb with a hard shadow. -->
    <Style x:Key="SwivelSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Border Background="{DynamicResource Ink}" CornerRadius="6" Margin="3,3,-3,-3" />
                        <Border x:Name="Face" Background="{DynamicResource Sunflower}" BorderBrush="{DynamicResource Ink}" BorderThickness="2.5" CornerRadius="6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwivelSlider" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="8" CornerRadius="4" Background="{DynamicResource Cream}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SwivelSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch: pill track with a square-ish knob; mint when on (the toggle on-state token). -->
    <Style x:Key="SwivelSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="52" Height="28">
                            <Border Background="{DynamicResource Ink}" CornerRadius="14" Margin="3,3,-3,-3" />
                            <Border x:Name="Track" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Ink}" BorderThickness="2.5" CornerRadius="14" />
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="6" Background="{DynamicResource Ink}"
                                    HorizontalAlignment="Left" Margin="5,0,0,0" />
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource BodyFont}"
                                          TextElement.FontWeight="SemiBold" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Mint}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Pink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwivelPrimaryButton" TargetType="Button" BasedOn="{StaticResource SwivelButton}">
        <Setter Property="Background" Value="{DynamicResource Sunflower}" />
    </Style>
</ResourceDictionary>
